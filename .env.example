# ─────────────────────────────────────────────────────────────
# EVOLT environment variables
# Copy to `.env.local` for local development. Never commit real values.
# All variables below are SERVER-ONLY unless prefixed NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (required).
# Neon:      postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# Supabase:  postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
# Local:     postgresql://evolt:evolt@localhost:5432/evolt
DATABASE_URL=postgresql://evolt:evolt@localhost:5432/evolt

# Who may import data, change workflow status and re-run the analysis.
#   open  – anyone who can reach the app; fine on your own computer or for a judged demo.
#   token – only requests carrying EVOLT_ADMIN_TOKEN. Use this for any public deployment.
# If unset: open when EVOLT_LOCAL_DB=true (the run-evolt launcher), otherwise token.
# Requests sent from other websites are refused in both modes.
EVOLT_EDIT_MODE=open

# Only used when EVOLT_EDIT_MODE=token. Use 32+ random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EVOLT_ADMIN_TOKEN=replace-with-a-long-random-string

# Optional. Maximum accepted upload size in bytes (default 2097152 = 2 MiB,
# hard ceiling 4 MiB to stay below Vercel's request-body limit).
EVOLT_MAX_UPLOAD_BYTES=2097152

# Test-only. Separate database used by `npm run test:integration`.
# It is migrated and truncated by the test suite — never point it at real data.
# Vitest runs with NODE_ENV=test, so put this line in `.env.test.local`.
TEST_DATABASE_URL=postgresql://evolt:evolt@localhost:5432/evolt_test

# Test-only. Database used by `npm run test:e2e`; it is wiped and re-seeded with demo data.
E2E_DATABASE_URL=postgresql://evolt:evolt@localhost:5432/evolt_e2e
